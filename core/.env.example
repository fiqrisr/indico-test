# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=indico_test_db
POSTGRES_PORT=5433

# Core API Settings
PORT=8081
GIN_MODE=debug
EXPIRY_INTERVAL=30s
RESERVATION_EXPIRY_MINUTES=5

# Direct Database URL for local development (outside Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/indico_test_db?sslmode=disable
